/.phpunit.cache
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
# Cualquier variante del archivo de entorno, no una lista de nombres exactos. Las
# tres reglas anteriores — `.env`, `.env.backup`, `.env.production` — dejaban
# rastreable cualquier otro nombre, y un respaldo hecho a mano antes de rotar una
# credencial es una copia completa del archivo: token del bot, clave de Gemini y
# contraseña de la base incluidas. `.env.example` se exceptúa porque sí es fuente.
.env*
!.env.example
.phpactor.json
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log
/.fleet
/.idea
/.vscode
/.zed

# Generated by `gentle-ai skill-registry refresh`; contains machine-local paths.
/.atl

# Volcado de una corrida de PHPStan; no es fuente.
phpstan_output.txt

# Claves privadas. `storage/app/private.pem` alimentaba el endpoint de WhatsApp Flows,
# que se eliminó; el archivo sigue en disco y nunca estuvo rastreado. Se ignora
# explícitamente para que siga sin estarlo.
*.key
storage/app/private.pem
