includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    # Pre-existing level-6 findings, frozen so CI blocks regressions only.
    # Shrink it as modules are touched; never regenerate it to hide new errors.
    - phpstan-baseline.neon
parameters:

    paths:
        - app/

    # Level 10 is the highest level
    level: 6

    ignoreErrors:
        - '#Method .*::.*\(\) return type with generic class .* does not specify its types#'
#        - '#PHPDoc tag @var#'
#
#    excludePaths:
#        - ./*/*/FileToBeExcluded.php